#!/usr/bin/env bash
# shuush — Superwhisper / Wispr Flow intelligence & GTK4 Studio layer for voxtype.
# Built on top of voxtype (MIT, https://voxtype.io).
# Website: https://shuush.kitsunekode.in
set -euo pipefail

resolve_libexec() {
  local self dir
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  dir="$(cd "$(dirname "$self")/.." && pwd)"
  if [ -d "$dir/libexec" ]; then
    printf '%s\n' "$dir/libexec"
  elif [ -d "$dir/lib/shuush/libexec" ]; then
    printf '%s\n' "$dir/lib/shuush/libexec"
  elif [ -d "/usr/lib/shuush/libexec" ]; then
    printf '%s\n' "/usr/lib/shuush/libexec"
  elif [ -d "/usr/share/shuush/libexec" ]; then
    printf '%s\n' "/usr/share/shuush/libexec"
  else
    printf '%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}/shuush/libexec"
  fi
}

resolve_share() {
  local self dir
  self="$(readlink -f "${BASH_SOURCE[0]}")"
  dir="$(cd "$(dirname "$self")/.." && pwd)"
  if [ -d "$dir/osd/kitsune-hud" ]; then
    printf '%s\n' "$dir"
  elif [ -d "$dir/share/shuush/osd/kitsune-hud" ]; then
    printf '%s\n' "$dir/share/shuush"
  elif [ -d "/usr/share/shuush/osd/kitsune-hud" ]; then
    printf '%s\n' "/usr/share/shuush"
  else
    printf '%s\n' ""
  fi
}

LIBEXEC="$(resolve_libexec)"
SHARE_DIR="$(resolve_share)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/voxtype"

usage() {
  cat <<'EOF'
shuush — context-aware cleanup, self-learning & GTK4 Studio for voxtype

Usage:
  shuush studio [--tab history|insights|corrections|vocab|snippets|settings]
  shuush toggle | hold | release | command
  shuush cancel [now]
  shuush postprocess [default|terminal|chat|command]
  shuush learn [list|pending|add HEARD MEANT|accept HEARD|reject HEARD|forget HEARD|fix|sync-toml]
  shuush doctor [--json]   Check voxtype, GPU, compositor, Wayland, AT-SPI, services, secrets & what the daemon can do
  shuush caps [list|has CAP...|--refresh]
                           What the running voxtype supports (stock or fork), as JSON
  shuush wire [--dry-run]  Set [output.post_process], profiles & OSD in config.toml (voxtype config set) and record the old values
  shuush wire --status     Which wired keys are still as Shuush set them
  shuush unwire [--dry-run]  Put every wired key back as it was before
  shuush recover           Copy the latest recovered text, or bring back a cancelled take
  shuush build-wtype [--check|--dry-run]  Build the patched wtype (fast, exact typing) into ~/.local/bin
  shuush build-ime [--check|--dry-run]    Build shuush-ime (live preedit, IME commit, field text) into ~/.local/bin
  shuush wire-config       Same as wire (kept for the installer and old scripts)
EOF
}

detect_gpu() {
  if command -v nvidia-smi >/dev/null 2>&1; then
    local g
    g="$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || true)"
    printf 'NVIDIA CUDA (%s)' "${g:-detected}"
  elif [ -e /dev/kfd ]; then
    printf 'AMD ROCm / Vulkan'
  elif ls /dev/dri/renderD* >/dev/null 2>&1; then
    printf 'Vulkan iGPU'
  else
    printf 'CPU'
  fi
}

detect_compositor() {
  if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || command -v hyprctl >/dev/null 2>&1; then
    if [ -d "${KUWAI_ROOT:-$HOME/.local/share/kuwai}" ] || [ -d "$HOME/Projects/rice/hypr/kuwai" ]; then
      printf 'Hyprland (kuwai first-party)'
    else
      printf 'Hyprland'
    fi
  elif [ -n "${NIRI_SOCKET:-}" ] || command -v niri >/dev/null 2>&1; then
    printf 'Niri'
  elif [ -n "${SWAYSOCK:-}" ] || command -v swaymsg >/dev/null 2>&1; then
    printf 'Sway'
  elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
    printf 'Wayland (%s)' "${XDG_CURRENT_DESKTOP:-generic}"
  else
    printf 'Unknown / non-Wayland'
  fi
}

doctor() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local g="" y="" b="" d="" r=""
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$json" = 0 ]; then
    g=$'\033[32m'; y=$'\033[33m'; b=$'\033[1m'; d=$'\033[2m'; r=$'\033[0m'
  fi

  local ok=0 warn=0 items=()
  local gpu comp vver
  gpu="$(detect_gpu)"
  comp="$(detect_compositor)"
  vver="$(voxtype --version 2>/dev/null | head -1 || echo 'not installed')"

  check() {
    local id="$1" cond="$2" label="$3" hint="${4:-}"
    if eval "$cond" >/dev/null 2>&1; then
      ok=$((ok + 1))
      if [ "$json" = 1 ]; then
        items+=("{\"id\":\"$id\",\"status\":\"ok\",\"label\":$(jq -Rn --arg s "$label" '$s')}")
      else
        printf '  %s[ok]%s   %s\n' "$g" "$r" "$label"
      fi
    else
      warn=$((warn + 1))
      if [ "$json" = 1 ]; then
        items+=("{\"id\":\"$id\",\"status\":\"warn\",\"label\":$(jq -Rn --arg s "$label" '$s'),\"fix\":$(jq -Rn --arg s "$hint" '$s')}")
      else
        printf '  %s[warn]%s %s%s\n' "$y" "$r" "$label" "${hint:+ — $hint}"
      fi
    fi
  }

  if [ "$json" = 0 ]; then
    printf '%sshuush doctor%s %s(%s · %s · %s)%s\n' "$b" "$r" "$d" "$vver" "$gpu" "$comp" "$r"
  fi

  check "voxtype_bin"  'command -v voxtype' "voxtype binary installed ($vver)" "install voxtype-bin (AUR / Omarchy / https://voxtype.io)"
  check "voxtype_svc"  'systemctl --user is-active --quiet voxtype.service' "voxtype.service active" "systemctl --user enable --now voxtype.service"
  check "clipboard"    'command -v wl-copy && command -v wl-paste' "wl-clipboard (wl-copy / wl-paste)" "pacman -S wl-clipboard"
  check "injector"     'command -v wtype || command -v ydotool || command -v dotool' "Wayland text injector (wtype/ydotool/dotool)" "pacman -S wtype"
  check "jq"           'command -v jq' "jq available" "pacman -S jq"
  check "gtk4"         'python3 -c "import gi; gi.require_version(\"Gtk\",\"4.0\"); gi.require_version(\"Adw\",\"1\")"' "GTK4 + Libadwaita Python bindings" "pacman -S python-gobject libadwaita gtk4"
  check "atspi"        'python3 -c "import gi; gi.require_version(\"Atspi\",\"2.0\"); from gi.repository import Atspi"' "AT-SPI screen & focused draft context (Atspi 2.0)" "pacman -S at-spi2-core python-gobject"
  check "a11y_flag"    '[ "$(gsettings get org.gnome.desktop.interface toolkit-accessibility 2>/dev/null)" = "true" ]' "AT-SPI toolkit-accessibility enabled" "gsettings set org.gnome.desktop.interface toolkit-accessibility true"
  check "config_toml"  '[ -f "$CONF/config.toml" ]' "voxtype config.toml exists" "run: voxtype setup"
  check "post_process" 'grep -q "postprocess" "$CONF/config.toml" 2>/dev/null' "post_process wired in config.toml" "run: shuush wire"
  check "wired_keys"   '[ "$(python3 -I "$LIBEXEC/shuush_wire.py" status --json 2>/dev/null | jq -r ".changed | length")" = 0 ]' "wired config keys are still as Shuush set them" "a key was changed since wiring: shuush wire --status (shuush wire --force re-applies)"
  check "osd_hud"      '[ -f "$CONF/osd/kitsune-hud/KitsuneHud.qml" ]' "KitsuneHud Quickshell pill installed" "re-run: ./install.sh"
  check "secrets_perm" '[ ! -f "$CONF/secrets.env" ] || [ "$(stat -c %a "$CONF/secrets.env")" = "600" ]' "secrets.env permissions secure (0600)" "chmod 600 $CONF/secrets.env"
  check "no_dup_proxy" '! (systemctl --user is-active --quiet voxtype-llm-proxy.service && systemctl --user is-active --quiet shuush-llm-proxy.service)' "No duplicate LLM proxy service on port 11435" "systemctl --user disable --now voxtype-llm-proxy.service"
  local pp_ime
  pp_ime=${PP_IME:-$(sed -n 's/^PP_IME=\([a-z]*\).*/\1/p' "$CONF/postprocess.env" 2>/dev/null | tail -1 || true)}
  if [ "$pp_ime" = shuush ]; then
    check "shuush_ime" 'python3 -I "$LIBEXEC/shuush_caps.py" ime' "shuush-ime input method (PP_IME=shuush)" "shuush build-ime (and a compositor with input-method-v2)"
  fi
  check "llm_ready"    '[ -f "$CONF/secrets.env" ] || curl -fsS --max-time 1 http://127.0.0.1:11434/api/tags' "LLM provider configured (secrets.env or local Ollama)" "open shuush studio -> Settings -> API keys or enable Offline mode"

  local caps_json
  caps_json="$(python3 -I "$LIBEXEC/shuush_caps.py" 2>/dev/null || echo '{}')"

  if [ "$json" = 1 ]; then
    printf '{"libexec":%s,"voxtype":%s,"capabilities":%s,"gpu":%s,"compositor":%s,"ok":%d,"warnings":%d,"checks":[%s]}\n' \
      "$(jq -Rn --arg s "$LIBEXEC" '$s')" \
      "$(jq -Rn --arg s "$vver" '$s')" \
      "$(jq -c . <<<"$caps_json" 2>/dev/null || echo '{}')" \
      "$(jq -Rn --arg s "$gpu" '$s')" \
      "$(jq -Rn --arg s "$comp" '$s')" \
      "$ok" "$warn" "$(IFS=,; echo "${items[*]}")"
  else
    printf 'Summary: %d ok, %d warning(s)\n' "$ok" "$warn"
    printf '\n%sThe daemon%s %s(%s, %s)%s\n' "$b" "$r" "$d" \
      "$(jq -r '.binary // "voxtype not found"' <<<"$caps_json" 2>/dev/null)" \
      "$(jq -r '(.version // "unknown") + (if .fork then ", fork" else ", stock" end)' <<<"$caps_json" 2>/dev/null)" "$r"
    python3 -I "$LIBEXEC/shuush_caps.py" list 2>/dev/null | sed 's/^/  /'
    printf '%s  off = Shuush works around it; see docs/voxtype-fork.md%s\n' "$d" "$r"
  fi
}

wire_config() {
  local a dry=0 action=wire
  for a in "$@"; do
    case "$a" in --dry-run) dry=1 ;; --status) action=status ;; esac
  done
  local args=() 
  for a in "$@"; do [ "$a" = --status ] || args+=("$a"); done
  if [ "$dry" = 0 ] && [ "$action" = wire ]; then
    mkdir -p "$CONF/osd/kitsune-hud"
    # Seed KitsuneHud & starter files if missing (supports AUR /usr installs too)
    if [ -n "$SHARE_DIR" ]; then
      [ -f "$CONF/osd/kitsune-hud/KitsuneHud.qml" ] || install -m 0644 "$SHARE_DIR/osd/kitsune-hud/KitsuneHud.qml" "$CONF/osd/kitsune-hud/KitsuneHud.qml"
      [ -f "$CONF/osd/kitsune-hud/voxtype-osd.toml" ] || install -m 0644 "$SHARE_DIR/osd/kitsune-hud/voxtype-osd.toml" "$CONF/osd/kitsune-hud/voxtype-osd.toml"
      [ -f "$CONF/postprocess.env" ] || install -m 0644 "$SHARE_DIR/config/postprocess.env.example" "$CONF/postprocess.env"
    fi
    [ -f "$CONF/vocabulary.txt" ] || printf '# Exact spellings for technical terms & proper nouns (one per line)\n' > "$CONF/vocabulary.txt"
    [ -f "$CONF/snippets" ] || printf '# Voice snippets: trigger -> expansion text\n' > "$CONF/snippets"
  fi
  exec python3 -I "$LIBEXEC/shuush_wire.py" "$action" --command "$LIBEXEC/voxtype-postprocess.sh" "${args[@]}"
}

unwire_config() {
  exec python3 -I "$LIBEXEC/shuush_wire.py" unwire "$@"
}

# The daemon's own binary, so `record recover` talks to the build that can answer it.
recover() {
  local rt take dir
  rt="${XDG_RUNTIME_DIR:-/run/user/$UID}/voxtype"
  take=$(cat "$rt/take_id" 2>/dev/null || true)
  if [[ "$take" =~ ^[0-9]+$ ]] && python3 -I "$LIBEXEC/shuush_caps.py" has take_identity take_recovery; then
    dir="$rt/takes/$take"
    if [ ! -e "$dir/pp_private" ] && [ "$(cat "$dir/disposition" 2>/dev/null)" = recovered ] && [ -s "$dir/recovered.txt" ]; then
      wl-copy < "$dir/recovered.txt" || exit 1
      notify-send -a Voxtype "Recovered dictation copied" >/dev/null 2>&1 || true
      exit 0
    fi
  fi
  if ! python3 -I "$LIBEXEC/shuush_caps.py" has record_recover; then
    echo "This voxtype has no 'record recover' (the companion fork does); nothing to bring back." >&2
    exit 3
  fi
  exec "$(python3 -I "$LIBEXEC/shuush_caps.py" bin)" record recover >/dev/null 2>&1
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  studio)      exec python3 "$LIBEXEC/voxtype-studio.py" "$@" ;;
  toggle|hold|release|command) exec "$LIBEXEC/voxtype-toggle.sh" "$cmd" "$@" ;;
  cancel)      exec "$LIBEXEC/voxtype-cancel.sh" "$@" ;;
  postprocess) exec "$LIBEXEC/voxtype-postprocess.sh" "$@" ;;
  learn)       exec python3 "$LIBEXEC/voxtype_learn.py" "$@" ;;
  waybar)      exec "$LIBEXEC/voxtype-waybar.sh" "$@" ;;
  last)        exec "$LIBEXEC/voxtype-last.sh" "$@" ;;
  replay)      exec "$LIBEXEC/voxtype-last-audio.sh" "$@" ;;
  doctor)      doctor "$@" ;;
  wire|wire-config) wire_config "$@" ;;
  unwire)      unwire_config "$@" ;;
  caps)        exec python3 -I "$LIBEXEC/shuush_caps.py" "$@" ;;
  recover)     recover ;;
  build-wtype) exec "$LIBEXEC/shuush-build-wtype.sh" "$@" ;;
  build-ime)   exec "$LIBEXEC/shuush-build-ime.sh" "$@" ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $cmd" >&2; usage >&2; exit 2 ;;
esac
