---
interface Props { class?: string; title?: string }
const { class: className = 'brand-mark', title } = Astro.props;
---
<svg class={className} viewBox="0 0 32 32" aria-hidden={title ? undefined : 'true'} role={title ? 'img' : undefined} aria-label={title}>
  <rect x="1" y="1" width="30" height="30" rx="8" fill="#13161d" />
  <rect x="1.5" y="1.5" width="29" height="29" rx="7.5" fill="none" stroke="#f3f5f8" stroke-opacity="0.14" />
  <g stroke="#ff4d2e" stroke-width="3.1" stroke-linecap="round">
    <path class="bar" d="M8.5 8.5v15" />
    <path class="bar" d="M14 11.5v9" />
    <path class="bar" d="M19.5 14.25v3.5" />
  </g>
  <circle cx="24.75" cy="16" r="2.05" fill="#34d399" />
</svg>
