---
import '@fontsource-variable/familjen-grotesk';
import familjenLatin from '@fontsource-variable/familjen-grotesk/files/familjen-grotesk-latin-wght-normal.woff2?url';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  publishedTime?: string;
  modifiedTime?: string;
  noindex?: boolean;
  heroBleed?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage = '/og.png',
  ogImageAlt = 'Shuush: open-source local GPU voice dictation for Linux and Wayland',
  ogImageWidth = 1200,
  ogImageHeight = 630,
  publishedTime,
  modifiedTime,
  noindex = false,
  heroBleed = false,
  jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = new URL(ogImage, Astro.site).toString();
const onBlog = Astro.url.pathname.startsWith('/blog');
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preload" as="font" type="font/woff2" href={familjenLatin} crossorigin />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#090a0d" />
  <script is:inline>
    (() => {
      try {
        if (localStorage.getItem('shuush-theme') === 'light') {
          document.documentElement.dataset.theme = 'light';
          document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#f5f6f8');
        }
      } catch {}
    })();
  </script>
  <link rel="canonical" href={canonicalURL.toString()} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="alternate" type="application/rss+xml" title="Shuush Blog RSS" href="/rss.xml" />
  <meta property="og:site_name" content="Shuush" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL.toString()} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOgImage} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:image:alt" content={ogImageAlt} />
  {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
  {ogType === 'article' && (modifiedTime || publishedTime) && <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />}
  {ogType === 'article' && <meta property="article:author" content="https://github.com/KitsuneKode" />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absoluteOgImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body class:list={[{ 'has-hero': heroBleed }]}>
  <a class="skip" href="#main">Skip to content</a>
  <header class="nav" id="site-nav" data-bleed={heroBleed ? 'true' : 'false'}>
    <div class="wrap nav-inner">
      <a href="/" class="brand" aria-label="Shuush home"><LogoMark /><span>Shuush</span></a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/#studio" class="hide-sm">Studio</a>
        <a href="/#pipeline" class="hide-sm">Pipeline</a>
        <a href="/#compare" class="hide-sm">Compare</a>
        <a href="/#install" class="hide-sm">Install</a>
        <a href="/blog/" aria-current={onBlog ? 'page' : undefined}>Writing</a>
        <a href="https://github.com/KitsuneKode/shuush" class="nav-gh" aria-label="Shuush on GitHub">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
          <span class="nav-gh-label">GitHub</span>
        </a>
        <button type="button" class="theme-btn" id="theme-btn" aria-label="Switch to light theme">
          <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
          <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"/></svg>
        </button>
      </nav>
    </div>
  </header>

  <slot />

  <footer class="foot">
    <div class="wrap">
      <div class="foot-grid">
        <div class="foot-about">
          <a href="/" class="brand" aria-label="Shuush home"><LogoMark /><span>Shuush</span></a>
          <p>
            Local, context-aware voice dictation for Linux and Wayland. MIT licensed companion layer built on stock{' '}
            <a href="https://github.com/peteonrails/voxtype">voxtype</a> by Peter Jackson.
          </p>
        </div>
        <div class="foot-col">
          <b>Product</b>
          <a href="/#keys">Hotkeys</a>
          <a href="/#studio">Studio</a>
          <a href="/#pipeline">Pipeline</a>
          <a href="/#install">Install</a>
          <a href="/#faq">FAQ</a>
        </div>
        <div class="foot-col">
          <b>Open source</b>
          <a href="https://github.com/KitsuneKode/shuush">GitHub</a>
          <a href="https://github.com/peteonrails/voxtype">voxtype</a>
          <a href="/blog/">Writing</a>
          <a href="/rss.xml">RSS</a>
          <a href="/llms.txt">llms.txt</a>
        </div>
      </div>
      <div class="foot-base">
        <span>© 2026 KitsuneKode · MIT License</span>
        <span>Say it once. It lands exact.</span>
      </div>
    </div>
  </footer>

  <script>
    import { inject } from '@vercel/analytics';
    import { injectSpeedInsights } from '@vercel/speed-insights';
    inject();
    injectSpeedInsights();

    const root = document.documentElement;
    const nav = document.getElementById('site-nav');
    const themeBtn = document.getElementById('theme-btn');
    const themeMeta = document.querySelector('meta[name="theme-color"]');

    const syncThemeUi = () => {
      const light = root.dataset.theme === 'light';
      themeBtn?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
      themeMeta?.setAttribute('content', light ? '#f5f6f8' : '#090a0d');
      document.querySelectorAll<HTMLImageElement>('.prose img[src$="architecture.png"], .prose img[src$="architecture-dark.png"]').forEach((img) => {
        img.src = light ? '/assets/architecture.png' : '/assets/architecture-dark.png';
      });
    };
    syncThemeUi();

    themeBtn?.addEventListener('click', () => {
      const light = root.dataset.theme !== 'light';
      root.classList.add('theme-switching');
      if (light) root.dataset.theme = 'light';
      else delete root.dataset.theme;
      try {
        localStorage.setItem('shuush-theme', light ? 'light' : 'dark');
      } catch {}
      syncThemeUi();
      requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove('theme-switching')));
    });

    if (nav) {
      const syncScroll = () => {
        nav.dataset.scrolled = window.scrollY > 18 ? 'true' : 'false';
      };
      syncScroll();
      addEventListener('scroll', syncScroll, { passive: true });
    }
  </script>
</body>
</html>
