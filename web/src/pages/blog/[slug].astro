---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate,
  dateModified: post.data.pubDate,
  author: { '@type': 'Person', name: 'KitsuneKode', url: 'https://github.com/KitsuneKode' },
  image: new URL(post.data.heroImage, Astro.site).toString(),
  keywords: post.data.tags.join(', '),
};
---
<BaseLayout
  title={`${post.data.title} — Shuush`}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.heroImage}
  jsonLd={jsonLd}
>
  <article class="prose">
    <div class="ctx-row" style="margin-block-end:16px;">
      <span class="pill pill-blue">{post.data.pubDate}</span>
      <span class="pill">{post.data.readTime}</span>
      {post.data.tags.map((t) => <span class="pill">{t}</span>)}
    </div>
    <h1>{post.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
