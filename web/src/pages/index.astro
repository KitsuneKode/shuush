---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMark from '../components/LogoMark.astro';

const SITE = 'https://shuush.kitsunekode.in/';
const INSTALL_ONE_LINER = 'curl -fsSL https://shuush.kitsunekode.in/install.sh | bash';
const INSTALL_FULL = [
  'curl -fsSL https://shuush.kitsunekode.in/doctor.sh | bash',
  'yay -S voxtype-bin wtype wl-clipboard jq python-gobject libadwaita gtk4 at-spi2-core',
  'voxtype setup',
  'curl -fsSL https://shuush.kitsunekode.in/install.sh | bash',
  'shuush doctor && shuush studio',
].join('\n');

const faqs = [
  {
    q: 'What is the best open-source Superwhisper or Wispr Flow alternative for Linux?',
    a: 'Shuush, built on stock voxtype, is a free, MIT-licensed Linux and Wayland alternative to Superwhisper and Wispr Flow. It runs local GPU speech recognition (Parakeet, Whisper, or Cohere GGUF) with no word caps, adds 5-source AT-SPI screen, selection, and clipboard context, anti-paraphrase LLM cleanup (100% offline Ollama or ~500 ms Groq failover), and a native GTK4 Studio.',
  },
  {
    q: 'Does Shuush work on Omarchy, Hyprland, Sway, Niri, and non-NVIDIA GPUs?',
    a: 'Yes. Shuush installs on top of stock voxtype-bin across NVIDIA CUDA, AMD ROCm/Vulkan, Intel Vulkan, and CPU-only laptops. Studio reads whichever voxtype engine you configured (parakeet, whisper, cohere, or moonshine), with first-party kuwai rice auto-discovery and standard Hyprland, Sway, and Niri support.',
  },
  {
    q: 'Can Shuush run 100% offline without sending audio or text to the cloud?',
    a: "Yes. Speech recognition always runs locally via voxtype, and Shuush Studio has a 1-click air-gapped offline mode that pins cleanup to local Ollama (127.0.0.1:11434). Password fields, password managers, sign-in pages, and sudo prompts skip LLM cleanup entirely and are never written to history or the clipboard, and a password manager's clipboard copy is never used as context.",
  },
  {
    q: 'What are the default Shuush hotkeys?',
    a: 'Super+Ctrl+D toggles dictation. Hold F9 for push-to-talk, or tap it (under 300 ms) for hands-free. Super+Ctrl+E is voice command, which rewrites your highlighted selection in place. Super+Alt+D opens Shuush Studio, and a double-tap of Esc cancels a take.',
  },
  {
    q: 'Do I need a fork of voxtype?',
    a: 'No. voxtype already nails PipeWire audio capture, CUDA/Vulkan/CPU inference, and Wayland typing, and Shuush works on stock voxtype-bin from the Arch AUR and Omarchy. A few extras need changes inside voxtype itself (live text in the focused field while you speak, learning from your fixes in Electron apps, recognition-level vocabulary); they live in an optional companion fork that tracks upstream, and are being offered to voxtype as pull requests so the fork can go away.',
  },
  {
    q: 'How does Shuush stop the cleanup model from changing what I said?',
    a: 'A deterministic gate (voxtype_pp_gate.py) aligns the cleaned text with what you said, word by word, and puts your words back wherever a change is not a real repair. Negations, numbers, contractions, and your own wording cannot change; a word is replaced only by a similar-sounding word that fits where it plainly does not, most often a name from your vocabulary, your screen, your selection, or a fresh clipboard copy. If the whole answer breaks a rule, your words are typed as heard.',
  },
  {
    q: 'Does Shuush learn from my corrections?',
    a: 'Yes. Fix a word in Studio and press Ctrl+Enter, or approve suggestions in the Learning Inbox. Shuush also watches the text field for a few minutes after each take: a name you correct by hand there is noted, and learned the second time. Ordinary English words are never learned as mishearings.',
  },
  {
    q: 'Which cleanup model should I use?',
    a: 'Groq with qwen3.8-27b (a free key) was the fastest and most literal on real dictations, about 0.7 s per take; add a second Groq key and a free Cerebras key as fallbacks, or Ollama for fully offline use. OpenCode Zen free models only answer inside the OpenCode app, so they cannot be used here.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'Shuush',
      url: SITE,
      image: new URL('/icon-512.png', SITE).toString(),
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Linux (Wayland: Hyprland, Sway, Niri, Arch Linux, Omarchy)',
      license: 'https://opensource.org/licenses/MIT',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      description:
        'Open-source local Superwhisper and Wispr Flow alternative for Linux and Wayland built on top of voxtype, featuring 5-source screen, selection, and clipboard context, anti-paraphrase span gating, phonetic self-learning, KitsuneHud Quickshell pill, and native GTK4 Studio.',
      softwareVersion: '1.0.0',
      author: { '@type': 'Person', name: 'KitsuneKode', url: 'https://github.com/KitsuneKode' },
      codeRepository: 'https://github.com/KitsuneKode/shuush',
      isBasedOn: {
        '@type': 'SoftwareSourceCode',
        name: 'voxtype',
        codeRepository: 'https://github.com/peteonrails/voxtype',
        license: 'https://opensource.org/licenses/MIT',
        author: { '@type': 'Person', name: 'Peter Jackson' },
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'HowTo',
      name: 'How to install Shuush on Linux and Wayland (Arch, Omarchy, Hyprland, Sway, Niri)',
      description: 'Install local GPU voice dictation and GTK4 Studio on top of stock voxtype-bin in three steps.',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Run pre-flight doctor and install stock voxtype',
          text: 'Run curl -fsSL https://shuush.kitsunekode.in/doctor.sh | bash, install voxtype-bin with Wayland/GTK4/AT-SPI dependencies, and run voxtype setup.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Install Shuush in one line',
          text: 'Run curl -fsSL https://shuush.kitsunekode.in/install.sh | bash to install Shuush, KitsuneHud, systemd units, and wire config.toml with an automatic backup.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Verify and open Shuush Studio',
          text: 'Run shuush doctor && shuush studio to pick Air-Gapped Ollama offline mode or enter cloud failover API keys (saved chmod 600).',
        },
      ],
    },
  ],
};

type Key = { id: string; label: string; accent?: boolean };
const K = {
  super: { id: 'super', label: 'Super' },
  ctrl: { id: 'ctrl', label: 'Ctrl' },
  alt: { id: 'alt', label: 'Alt' },
  d: { id: 'd', label: 'D', accent: true },
  e: { id: 'e', label: 'E', accent: true },
  f9: { id: 'f9', label: 'F9', accent: true },
} satisfies Record<string, Key>;

const combos: { mode: string; keys: Key[]; name: string; hint: string; aria: string }[] = [
  { mode: 'toggle', keys: [K.super, K.ctrl, K.d], name: 'Toggle dictation', hint: 'Press to start, again to deliver', aria: 'Super plus Ctrl plus D: toggle dictation' },
  { mode: 'ptt', keys: [K.f9], name: 'Push-to-talk', hint: 'Hold to talk, tap for hands-free', aria: 'F9: hold for push-to-talk, tap for hands-free' },
  { mode: 'command', keys: [K.super, K.ctrl, K.e], name: 'Voice command', hint: 'Rewrite highlighted text in place', aria: 'Super plus Ctrl plus E: voice command' },
  { mode: 'studio', keys: [K.super, K.alt, K.d], name: 'Shuush Studio', hint: 'Open the GTK4 control center', aria: 'Super plus Alt plus D: open Shuush Studio' },
];

const studioShots = [
  {
    id: 'diff',
    tab: 'Dictations',
    src: '/assets/studio-diff-1140.webp',
    srcset: '/assets/studio-diff-640.webp 640w, /assets/studio-diff-1140.webp 1140w',
    alt: 'Shuush Studio dictation history with the inline Heard to Cleaned diff inspector',
    caption: 'Every take streams in live. Inspect the word-level diff, replay audio, or teach a fix with Ctrl+Enter.',
  },
  {
    id: 'insights',
    tab: 'Insights',
    src: '/assets/studio-insights-1140.webp',
    srcset: '/assets/studio-insights-640.webp 640w, /assets/studio-insights-1140.webp 1140w',
    alt: 'Shuush Studio insights with 14-day volume and full-history auto-mine',
    caption: '14-day dictation volume and a full-history auto-mine that surfaces repairs worth learning.',
  },
  {
    id: 'learning',
    tab: 'Learning',
    src: '/assets/studio-learning-1140.webp',
    srcset: '/assets/studio-learning-640.webp 640w, /assets/studio-learning-1140.webp 1140w',
    alt: 'Shuush Studio self-learning inbox and corrections memory',
    caption: 'A self-learning inbox with phonetic guards. Reject a rule once and it stays rejected, with undo.',
  },
  {
    id: 'settings',
    tab: 'Settings',
    src: '/assets/studio-settings-1140.webp',
    srcset: '/assets/studio-settings-640.webp 640w, /assets/studio-settings-1140.webp 1140w',
    alt: 'Shuush Studio settings with drag-and-drop provider failover and offline mode',
    caption: 'Drag-and-drop provider failover, API keys kept at chmod 600, and a 1-click air-gapped Ollama mode.',
  },
];

const specs = [
  { val: '19,498', unit: 'words', label: 'Dictated in daily work' },
  { val: '333', unit: 'takes', label: 'Measured sessions' },
  { val: '516', unit: 'ms', label: 'Median cleanup', cls: 'hot' },
  { val: '1,060', unit: 'ms', label: 'P90 cleanup' },
  { val: '2.3', unit: 'GB', label: 'VRAM (Parakeet fp16)' },
  { val: '98.8', unit: '%', label: 'Cleanup reliability', cls: 'ok' },
];

const copyIcons = `<svg class="ic-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5"/><path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5"/></svg><svg class="ic-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>`;
---
<BaseLayout
  title="Shuush: Local Superwhisper Alternative for Linux"
  description="Free MIT local GPU voice dictation for Linux and Wayland on stock voxtype. Five-source screen context, 516 ms cleanup, offline Ollama, and native GTK4 Studio."
  heroBleed={true}
  jsonLd={jsonLd}
>
  <main id="main">
    <!-- Hero: Full-bleed atmospheric horizon + monumental centered headline + wide interactive acoustic deck -->
    <section class="hero">
      <div class="hero-atmo" aria-hidden="true"></div>
      <div class="wrap">
        <div class="hero-header">
          <h1 class="rise" style="--i:0">Voice dictation that knows your screen.</h1>
          <p class="hero-sub rise" style="--i:1">
            Local GPU speech recognition for Linux and Wayland, grounded by your open window and cleaned without rewriting your meaning.
          </p>
          <div class="hero-action rise" style="--i:2">
            <a href="#install" class="btn-primary">Install on Linux <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="deck-shell rise" style="--i:3" id="keys" role="region" aria-labelledby="keys-title">
          <h2 id="keys-title" class="sr-only">Interactive hotkeys and launch demo</h2>
          <div class="deck-bar">
            <div class="seg" role="tablist" aria-label="Stage view" id="deck-tabs">
              <span class="seg-ind" aria-hidden="true"></span>
              <button class="seg-tab" type="button" role="tab" id="deck-tab-keys" aria-controls="deck-pane-keys" aria-selected="true" tabindex="0">Live hotkeys</button>
              <button class="seg-tab" type="button" role="tab" id="deck-tab-video" aria-controls="deck-pane-video" aria-selected="false" tabindex="-1">Watch 1080p demo</button>
            </div>
            <span class="deck-meta">Built on MIT voxtype · press real keys or click a pad</span>
          </div>

          <div class="deck-stage">
            <div class="deck-pane" id="deck-pane-keys" role="tabpanel" aria-labelledby="deck-tab-keys">
              <div class="chamber">
                <div class="hud" id="hud" data-state="idle">
                  <span class="hud-sig" aria-hidden="true">
                    <canvas class="hud-wave-canvas" id="hud-canvas" width="168" height="64"></canvas>
                    <svg class="hud-check" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="currentColor" opacity=".18"/><path d="M7.5 12.5l3 3 6-6.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span class="hud-label" id="hud-label"><b>Ready</b> · press a binding or click below</span>
                  <span class="hud-time" id="hud-time" aria-hidden="true">0:00</span>
                </div>
                <p class="mode-detail" id="mode-detail" aria-live="polite">
                  Four bindings are the whole interface. <strong>Press them on your keyboard</strong> or click a pad to watch KitsuneHud react. Double-tap Esc cancels any take.
                </p>
              </div>

              <div class="combos">
                {combos.map((c) => (
                  <button class="combo" type="button" data-mode={c.mode} aria-pressed="false" aria-label={c.aria}>
                    <span class="combo-keys" aria-hidden="true">
                      {c.keys.map((k, i) => (
                        <>
                          {i > 0 && <span class="combo-plus">+</span>}
                          <span class:list={['key', { accent: k.accent }]} data-key={k.id}><span class="key-face">{k.label}</span></span>
                        </>
                      ))}
                    </span>
                    <span class="combo-name">{c.name}<span class="combo-hint">{c.hint}</span></span>
                  </button>
                ))}
              </div>
            </div>

            <div class="deck-pane" id="deck-pane-video" role="tabpanel" aria-labelledby="deck-tab-video" hidden>
              <div class="video-wrap" id="hero-video-wrap">
                <video id="hero-video" class="stage-media" controls muted loop playsinline preload="none" poster="/assets/shuush-outro.webp" width="1280" height="720" aria-label="Shuush launch video: dictating into a terminal on Hyprland">
                  <source src="/assets/shuush-launch.webm" type="video/webm" />
                  <source src="/assets/shuush-launch.mp4" type="video/mp4" />
                  <track kind="captions" src="/assets/shuush-launch.vtt" srclang="en" label="English" />
                </video>
                <button type="button" class="play-pill" id="hero-play-btn" aria-label="Play 1080p launch demo video">
                  <span class="play-dot" aria-hidden="true"><svg width="11" height="12" viewBox="0 0 11 12" fill="currentColor"><path d="M1.5 1.2 10 6 1.5 10.8V1.2Z"/></svg></span>
                  Play launch demo
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Benchmarks: Architectural hairline ledger -->
    <section class="block" id="benchmarks">
      <div class="wrap">
        <div class="sec-head split">
          <h2>Measured on a daily laptop, never a slide.</h2>
          <p class="sec-sub">Telemetry from real coding and writing takes. When a transcript is already clean, Shuush skips the cleanup model completely and types in 24 ms.</p>
        </div>
        <div class="specs">
          {specs.map((s) => (
            <div class:list={['spec', s.cls]}>
              <span class="spec-val">{s.val}<span class="spec-unit">{s.unit}</span></span>
              <span class="spec-label">{s.label}</span>
            </div>
          ))}
        </div>
        <p class="rig">Intel i5-13450HX · RTX 4050 Laptop 6 GB · 23 GiB RAM · Arch Linux with Hyprland · roughly 8.1 hours saved versus 40 WPM typing. Read the <a href="/blog/why-we-built-shuush/" class="inline-link">architecture notes and benchmarks</a>.</p>
      </div>
    </section>

    <!-- Shuush Studio: Native GTK4 interactive showcase -->
    <section class="block" id="studio">
      <div class="wrap">
        <div class="sec-head split">
          <h2>Native GTK4 control, live word diffs, one offline switch.</h2>
          <p class="sec-sub">No Electron overhead. Dictations stream in through <code class="inline-code">Gio.FileMonitor</code>, every repaired symbol is highlighted, and approved vocabulary syncs straight into voxtype.</p>
        </div>

        <div class="studio-bar">
          <div class="seg" role="tablist" aria-label="Studio screens" id="studio-tabs">
            <span class="seg-ind" aria-hidden="true"></span>
            {studioShots.map((s, i) => (
              <button class="seg-tab" type="button" role="tab" id={`tab-${s.id}`} aria-controls="studio-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-caption={s.caption}>{s.tab}</button>
            ))}
          </div>
          <p class="studio-caption" id="studio-caption" aria-live="polite">{studioShots[0].caption}</p>
        </div>

        <div class="studio-stage" id="studio-panel" role="tabpanel" aria-labelledby="tab-diff">
          <div class="shots">
            {studioShots.map((s, i) => (
              <img
                src={i === 0 ? s.src : 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=='}
                srcset={i === 0 ? s.srcset : undefined}
                data-src={i === 0 ? undefined : s.src}
                data-srcset={i === 0 ? undefined : s.srcset}
                sizes="(max-width: 760px) calc(100vw - 48px), 1140px"
                alt={s.alt}
                width="1140"
                height="750"
                loading="lazy"
                decoding="async"
                data-active={i === 0 ? 'true' : 'false'}
                aria-hidden={i === 0 ? undefined : 'true'}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Pipeline: Asymmetric Span Gate Explorer + Real 60 fps KitsuneHud capture -->
    <section class="block" id="pipeline">
      <div class="wrap">
        <div class="sec-head split">
          <h2>Grounded by your window. Protected from paraphrasing.</h2>
          <p class="sec-sub">Every take passes a deterministic span gate (<code class="inline-code">voxtype_pp_gate.py</code>), so cleanup repairs misheard symbols from your screen without altering your wording, numbers, or negations.</p>
        </div>

        <div class="pipeline-split">
          <div class="pipeline-col">
            <h3>Five context sources, one deterministic gate</h3>
            <p class="pipeline-col-desc">Active app, AT-SPI screen and draft, highlighted selection, fresh clipboard copy, and date. Inspect how each case behaves.</p>
            <div class="seg" role="tablist" aria-label="Context scenarios" id="ctx-tabs">
              <span class="seg-ind" aria-hidden="true"></span>
              <button class="seg-tab" type="button" role="tab" aria-selected="true" tabindex="0" data-case="code" aria-controls="ctx-panel">Terminal code</button>
              <button class="seg-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-case="cmd" aria-controls="ctx-panel">Voice command</button>
              <button class="seg-tab" type="button" role="tab" aria-selected="false" tabindex="-1" data-case="priv" aria-controls="ctx-panel">Password guard</button>
            </div>
            <div class="diff-panel" id="ctx-panel" role="tabpanel">
              <span class="diff-heading" id="ctx-heading"></span>
              <div class="diff-body" id="ctx-diff"></div>
              <div class="diff-meta" id="ctx-meta"></div>
            </div>
            <p class="diff-note" id="ctx-note"></p>
          </div>

          <div class="pipeline-col">
            <h3>KitsuneHud pill, recorded live on Hyprland</h3>
            <p class="pipeline-col-desc">Unedited 60 fps Wayland layer-shell capture via <code class="inline-code">gpu-screen-recorder</code>.</p>
            <div class="pill-frame">
              <video class="stage-media" muted loop playsinline preload="none" width="1120" height="372" data-autoplay aria-label="KitsuneHud pill cycling through listening, live preview, polishing and delivered states">
                <source src="/assets/osd-pill-states.mp4" type="video/mp4" />
                <track kind="captions" src="/assets/osd-pill-states.vtt" srclang="en" label="English" />
              </video>
            </div>
            <ol class="states">
              <li style="--c:var(--accent)"><b>Listening</b>Live PipeWire waveform and target window</li>
              <li style="--c:var(--info)"><b>Live preview</b>Staggered word-by-word color wash</li>
              <li style="--c:var(--warn)"><b>Polishing</b>Anti-paraphrase cleanup in roughly 500 ms</li>
              <li style="--c:var(--ok)"><b>Delivered</b>Gathered checkmark and shrink-to-dot exit</li>
            </ol>
            <p class="pill-foot">Quickshell layer-shell overlay · double-tap Esc cancels any active take.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Compare: Clean architectural ledger -->
    <section class="block" id="compare">
      <div class="wrap">
        <div class="sec-head">
          <h2>How Shuush compares to paid cloud dictation.</h2>
        </div>
        <div class="table-wrap">
          <table class="cmp">
            <thead>
              <tr>
                <th scope="col">Capability</th>
                <th scope="col">Wispr Flow</th>
                <th scope="col">Superwhisper</th>
                <th scope="col" class="col-us">Shuush + voxtype</th>
              </tr>
            </thead>
            <tbody>
              <tr><th scope="row">Price and word cap</th><td>$15/mo</td><td>10,000 free words/mo</td><td class="col-us">Free · MIT · unlimited</td></tr>
              <tr><th scope="row">Native Linux and Wayland</th><td>No (macOS, Windows)</td><td>Omarchy, macOS</td><td class="col-us">Hyprland, Sway, Niri, Omarchy, Arch</td></tr>
              <tr><th scope="row">GPU and speech engines</th><td>Cloud only</td><td>Apple Silicon, cloud</td><td class="col-us">NVIDIA CUDA, AMD and Intel Vulkan, CPU</td></tr>
              <tr><th scope="row">Context sources</th><td>App and screen</td><td>App, selection, clipboard</td><td class="col-us">App, AT-SPI screen and draft, selection, ≤15 s clipboard, date</td></tr>
              <tr><th scope="row">Offline privacy mode</th><td>No</td><td>Paid local tier</td><td class="col-us">1-click air-gapped Ollama plus AT-SPI password bypass</td></tr>
              <tr><th scope="row">Self-learning dictionary</th><td>Learns from edits</td><td>Manual or AI audit</td><td class="col-us">Learns manual fixes, phonetic auto-mine, reject list</td></tr>
              <tr><th scope="row">Meaning preservation</th><td>Closed prompt</td><td>Closed prompt</td><td class="col-us">Deterministic gate keeps negations, numbers, and wording intact</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Install: Three-step workbench + modular architecture -->
    <section class="block" id="install">
      <div class="wrap">
        <div class="sec-head split">
          <h2>Three steps on top of stock voxtype.</h2>
          <p class="sec-sub">Shuush layers cleanly over <code class="inline-code">voxtype-bin</code> instead of replacing it. Each component owns a single job so nothing drifts.</p>
        </div>

        <div class="install-grid">
          <div class="term">
            <div class="term-head">
              <span>zsh · Arch Linux and Omarchy</span>
              <button class="copy" type="button" data-copy={INSTALL_FULL} aria-label="Copy all install commands" set:html={copyIcons} />
            </div>
<pre><span class="c"># Optional pre-flight check</span>
<span class="p">$ </span>curl -fsSL https://shuush.kitsunekode.in/doctor.sh | bash
<span class="c"># 1. Install voxtype and Wayland dependencies</span>
<span class="p">$ </span>yay -S voxtype-bin wtype wl-clipboard jq \
    python-gobject libadwaita gtk4 at-spi2-core
<span class="p">$ </span>voxtype setup
<span class="c"># 2. Install Shuush on top</span>
<span class="p">$ </span>curl -fsSL https://shuush.kitsunekode.in/install.sh | bash
<span class="c"># 3. Verify and launch Studio</span>
<span class="p">$ </span>shuush doctor &amp;&amp; shuush studio</pre>
          </div>

          <div class="facts-wrap">
            <h3>Supported environments</h3>
            <dl class="facts">
              <div class="fact-row"><dt>Compositors</dt><dd>Hyprland, Sway, Niri, Omarchy</dd></div>
              <div class="fact-row"><dt>Accelerators</dt><dd>NVIDIA CUDA, AMD ROCm/Vulkan, Intel Vulkan, CPU</dd></div>
              <div class="fact-row"><dt>ASR engines</dt><dd>Parakeet, Whisper, Cohere GGUF, Moonshine</dd></div>
              <div class="fact-row"><dt>Cleanup</dt><dd>Local Ollama, or Groq to OpenRouter failover</dd></div>
            </dl>
          </div>
        </div>

        <div class="own">
          <div class="own-col">
            <span class="own-title"><span class="own-sw" style="background:var(--muted)" aria-hidden="true"></span>voxtype</span>
            <p class="own-by">By Peter Jackson · MIT</p>
            <ul class="own-list">
              <li>PipeWire audio capture</li>
              <li>CUDA, Vulkan, and CPU speech recognition</li>
              <li>Wayland input typing</li>
            </ul>
          </div>
          <div class="own-col">
            <span class="own-title"><span class="own-sw" style="background:var(--accent)" aria-hidden="true"></span>shuush</span>
            <p class="own-by">This repository · MIT</p>
            <ul class="own-list">
              <li>Five-source context pipeline</li>
              <li>Anti-paraphrase span gate</li>
              <li>Phonetic self-learning memory</li>
              <li>KitsuneHud pill and GTK4 Studio</li>
            </ul>
          </div>
          <div class="own-col">
            <span class="own-title"><span class="own-sw" style="background:var(--ok)" aria-hidden="true"></span>kuwai</span>
            <p class="own-by">Your desktop rice or config</p>
            <ul class="own-list">
              <li>Hyprland binds and window rules</li>
              <li>Optional island OSD hosting</li>
              <li>Auto-discovery of <code class="inline-code">shuush/libexec</code></li>
            </ul>
          </div>
        </div>

        <figure class="arch-figure">
          <img class="stage-media arch-dark" src="/assets/architecture-dark.svg" alt="Shuush and voxtype pipeline: local ASR, five-source context, cleanup and span gate, Studio, and the self-learning memory loop" width="1120" height="420" loading="lazy" decoding="async" />
          <img class="stage-media arch-light" src="/assets/architecture.svg" alt="Shuush and voxtype pipeline: local ASR, five-source context, cleanup and span gate, Studio, and the self-learning memory loop" width="1120" height="420" loading="lazy" decoding="async" />
        </figure>

        <div class="credit-row">
          <p><strong>Shuush builds directly on voxtype.</strong> Everything works with stock <code class="inline-code">voxtype-bin</code>. Experimental extras live in an <a class="inline-link" href="https://github.com/KitsuneKode/shuush/blob/main/docs/voxtype-fork.md">optional companion fork</a> and are offered upstream.</p>
          <a class="inline-link" href="https://github.com/peteonrails/voxtype">peteonrails/voxtype ↗</a>
        </div>
      </div>
    </section>

    <!-- FAQ: Clean hairline accordion -->
    <section class="block" id="faq">
      <div class="wrap-mid">
        <div class="sec-head">
          <h2>Direct answers before you install.</h2>
        </div>
        <div class="faq">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}<span class="pm" aria-hidden="true"></span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing CTA -->
    <section class="block">
      <div class="wrap outro">
        <LogoMark class="outro-mark" />
        <h2>Say it once. It lands exact.</h2>
        <p class="outro-sub">Free, local, and yours to inspect. Two minutes from install to your first clean take.</p>
        <div class="cmd" role="group" aria-label="Install command">
          <span class="prompt" aria-hidden="true">$</span>
          <code>{INSTALL_ONE_LINER}</code>
          <button class="copy" type="button" data-copy={INSTALL_ONE_LINER} aria-label="Copy install command" set:html={copyIcons} />
        </div>
        <a href="https://github.com/KitsuneKode/shuush" class="btn-primary">Star on GitHub <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <script>
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Copy to clipboard with smooth icon morph */
    document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((btn) => {
      let timer: ReturnType<typeof setTimeout> | undefined;
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
        } catch {
          return;
        }
        btn.dataset.copied = 'true';
        const label = btn.getAttribute('aria-label') ?? '';
        btn.setAttribute('aria-label', 'Copied');
        clearTimeout(timer);
        timer = setTimeout(() => {
          btn.dataset.copied = 'false';
          btn.setAttribute('aria-label', label);
        }, 1800);
      });
    });

    /* Hero video click-to-play (0 bytes until played) */
    const heroWrap = document.getElementById('hero-video-wrap');
    const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null;
    const heroPlayBtn = document.getElementById('hero-play-btn');
    heroPlayBtn?.addEventListener('click', () => {
      heroVideo?.play().catch(() => {});
    });
    heroVideo?.addEventListener('play', () => heroWrap?.classList.add('is-playing'));
    heroVideo?.addEventListener('pause', () => {
      if (heroVideo.currentTime === 0 || heroVideo.ended) heroWrap?.classList.remove('is-playing');
    });

    /* Autoplay KitsuneHud recording only while visible */
    if (!reduceMotion && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => {});
            else v.pause();
          }
        },
        { threshold: 0.35 },
      );
      document.querySelectorAll('video[data-autoplay]').forEach((v) => io.observe(v));
    }

    /* Segmented tabs with spring-gliding pill indicator */
    function segmented(root: HTMLElement | null, onSelect: (tab: HTMLButtonElement, index: number) => void) {
      if (!root) return;
      const ind = root.querySelector<HTMLElement>('.seg-ind');
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const current = () => tabs.find((t) => t.getAttribute('aria-selected') === 'true') ?? tabs[0];
      const place = (tab: HTMLButtonElement) => {
        if (!ind) return;
        ind.style.inlineSize = `${tab.offsetWidth}px`;
        ind.style.transform = `translateX(${tab.offsetLeft}px)`;
      };
      const select = (tab: HTMLButtonElement, focus = false) => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.tabIndex = on ? 0 : -1;
        });
        place(tab);
        if (focus) tab.focus();
        onSelect(tab, tabs.indexOf(tab));
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener('click', () => select(tab));
        tab.addEventListener('keydown', (e) => {
          const next =
            e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : null;
          if (next === null) return;
          e.preventDefault();
          select(tabs[(next + tabs.length) % tabs.length], true);
        });
      });
      place(current());
      requestAnimationFrame(() => ind?.classList.add('ready'));
      document.fonts?.ready.then(() => place(current()));
      new ResizeObserver(() => place(current())).observe(root);
    }

    /* Hero Deck stage toggle (Live hotkeys vs 1080p demo) */
    const deckPaneKeys = document.getElementById('deck-pane-keys');
    const deckPaneVideo = document.getElementById('deck-pane-video');
    segmented(document.getElementById('deck-tabs'), (_tab, index) => {
      const showKeys = index === 0;
      if (deckPaneKeys) deckPaneKeys.hidden = !showKeys;
      if (deckPaneVideo) deckPaneVideo.hidden = showKeys;
      if (showKeys && heroVideo && !heroVideo.paused) heroVideo.pause();
    });

    /* Studio screen switcher */
    const shots = Array.from(document.querySelectorAll<HTMLImageElement>('#studio-panel img'));
    const studioCaption = document.getElementById('studio-caption');
    const studioPanel = document.getElementById('studio-panel');
    const studioTabs = document.getElementById('studio-tabs');
    const hydrateShot = (img: HTMLImageElement) => {
      if (img.dataset.srcset) {
        img.srcset = img.dataset.srcset;
        delete img.dataset.srcset;
      }
      if (img.dataset.src) {
        img.src = img.dataset.src;
        delete img.dataset.src;
      }
    };
    const hydrateAllShots = () => shots.forEach(hydrateShot);
    studioTabs?.addEventListener('pointerenter', hydrateAllShots, { once: true });
    studioTabs?.addEventListener('focusin', hydrateAllShots, { once: true });
    segmented(studioTabs, (tab, index) => {
      shots.forEach((img, i) => {
        if (i === index) hydrateShot(img);
        img.dataset.active = String(i === index);
        if (i === index) img.removeAttribute('aria-hidden');
        else img.setAttribute('aria-hidden', 'true');
      });
      if (studioCaption) studioCaption.textContent = tab.dataset.caption ?? '';
      studioPanel?.setAttribute('aria-labelledby', tab.id);
    });

    /* Context & span gate explorer */
    const CASES: Record<string, { heading: string; html: string; meta: string; note: string }> = {
      code: {
        heading: 'Heard to cleaned diff',
        html:
          '<span class="del">um</span> Open <span class="del">webar</span> <span class="ins">Waybar</span> in <span class="del">next year</span> <span class="ins">Next.js</span> and <span class="del">uh</span> check why <span class="del">box type pp gate</span> <span class="ins">voxtype_pp_gate</span> is dropping the <span class="del">hyperline</span> <span class="ins">Hyprland</span> flag.',
        meta: 'Sources: T3 Code · AT-SPI screen · selection voxtype_pp_gate.py · 482 ms',
        note: 'All four symbol repairs were grounded in vocabulary.txt and visible screen terms. Ordinary English stayed untouched.',
      },
      cmd: {
        heading: 'Highlighted selection rewritten in place',
        html:
          '<span class="del">So basically we are trying to make sure the timeout doesnt hang forever when the proxy is down</span><br/><span class="ins">Enforce a bounded timeout so a stalled proxy fails over immediately to direct Groq.</span>',
        meta: 'Trigger: Super+Ctrl+E · Highlighted selection · Replaced in place',
        note: 'Highlight text, press Super+Ctrl+E, say "make this tighter", and Shuush rewrites the selection right where it sits.',
      },
      priv: {
        heading: 'Focused password field detected',
        html:
          'AT-SPI detected a focused <strong>password or sign-in</strong> input. <span class="ok-txt">Cleanup model bypassed, typed locally, excluded from history and clipboard.</span>',
        meta: 'Policy: PP_PRIVATE_GUARD=1 · Zero network calls · Not written to history.jsonl',
        note: 'Password managers, sudo prompts, and sign-in fields never leave your machine, even when cloud cleanup is enabled.',
      },
    };
    const ctxHeading = document.getElementById('ctx-heading');
    const ctxDiff = document.getElementById('ctx-diff');
    const ctxMeta = document.getElementById('ctx-meta');
    const ctxNote = document.getElementById('ctx-note');
    function renderCase(key: string, animate: boolean) {
      const c = CASES[key] ?? CASES.code;
      if (ctxHeading) ctxHeading.textContent = c.heading;
      if (ctxDiff) ctxDiff.innerHTML = c.html;
      if (ctxMeta) ctxMeta.textContent = c.meta;
      if (ctxNote) ctxNote.textContent = c.note;
      if (animate && !reduceMotion) {
        ctxDiff?.animate(
          [{ opacity: 0, transform: 'translateY(4px)' }, { opacity: 1, transform: 'none' }],
          { duration: 220, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
        );
      }
    }
    renderCase('code', false);
    segmented(document.getElementById('ctx-tabs'), (tab) => renderCase(tab.dataset.case ?? 'code', true));

    /* Live harmonic canvas waveform inside KitsuneHud pill */
    const hudCanvas = document.getElementById('hud-canvas') as HTMLCanvasElement | null;
    const hudCtx = hudCanvas?.getContext('2d');
    type HudState = 'idle' | 'listening' | 'polishing' | 'delivered';
    let hudState: HudState = 'idle';
    let waveEnergy = 0.08;
    let targetEnergy = 0.08;
    let wavePhase = 0;

    function drawWave(now: number) {
      if (!hudCtx || !hudCanvas) return;
      const w = hudCanvas.width;
      const h = hudCanvas.height;
      hudCtx.clearRect(0, 0, w, h);

      targetEnergy = hudState === 'listening' ? 1.0 : hudState === 'polishing' ? 0.42 : 0.1;
      waveEnergy += (targetEnergy - waveEnergy) * 0.14;
      wavePhase = now * (hudState === 'listening' ? 0.0085 : hudState === 'polishing' ? 0.005 : 0.002);

      const bars = 13;
      const gap = 5;
      const barW = 6;
      const totalW = bars * barW + (bars - 1) * gap;
      const startX = (w - totalW) / 2;
      const color = hudState === 'listening' ? '#ff4d2e' : hudState === 'polishing' ? '#fbbf24' : '#677082';
      hudCtx.fillStyle = color;

      for (let i = 0; i < bars; i++) {
        const norm = (i / (bars - 1)) * 2 - 1;
        const env = Math.cos(norm * Math.PI * 0.48);
        const osc = reduceMotion
          ? 0.5
          : 0.5 + 0.32 * Math.sin(wavePhase + i * 0.72) + 0.18 * Math.cos(wavePhase * 1.65 - i * 1.15);
        const barH = Math.max(6, (8 + 44 * env * osc) * waveEnergy + 6 * (1 - waveEnergy));
        const x = startX + i * (barW + gap);
        const y = (h - barH) / 2;
        hudCtx.beginPath();
        hudCtx.roundRect(x, y, barW, barH, 3);
        hudCtx.fill();
      }
      if (!reduceMotion) requestAnimationFrame(drawWave);
    }
    drawWave(0);

    /* Tactile hotkey plate */
    type Mode = 'toggle' | 'ptt' | 'command' | 'studio';
    const hud = document.getElementById('hud');
    const hudLabel = document.getElementById('hud-label');
    const hudTime = document.getElementById('hud-time');
    const detail = document.getElementById('mode-detail');
    const combos = Array.from(document.querySelectorAll<HTMLButtonElement>('.combo'));
    const IDLE = '<b>Ready</b> · press a binding or click below';
    const DETAIL: Record<Mode, string> = {
      toggle: '<strong>Toggle dictation.</strong> Press once to start listening into the focused window, press again and cleaned text lands in place.',
      ptt: '<strong>Push-to-talk.</strong> Hold F9 while speaking and release to deliver. A quick tap under 300 ms latches hands-free until you tap again.',
      command: '<strong>Voice command.</strong> Highlight text, press Super+Ctrl+E, and say how to revise it. The selection is rewritten in place.',
      studio: '<strong>Shuush Studio.</strong> Opens the GTK4 control center with live history, diffs, learning memory, and the offline switch.',
    };

    let timers: ReturnType<typeof setTimeout>[] = [];
    let clock: ReturnType<typeof setInterval> | undefined;
    let listening: Mode | null = null;
    let handsFree = false;
    let stopOnRelease = false;
    let holdStartedAt = 0;

    const later = (ms: number, fn: () => void) => timers.push(setTimeout(fn, ms));
    function reset() {
      timers.forEach(clearTimeout);
      timers = [];
      clearInterval(clock);
      clock = undefined;
    }
    function setHud(state: HudState, html: string) {
      hudState = state;
      if (reduceMotion) drawWave(0);
      if (!hud || !hudLabel) return;
      hud.dataset.state = state;
      hudLabel.innerHTML = html;
    }
    function setPressed(mode: Mode | null) {
      combos.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.mode === mode)));
    }
    function startClock() {
      const t0 = performance.now();
      if (hudTime) hudTime.textContent = '0:00';
      clock = setInterval(() => {
        const s = Math.floor((performance.now() - t0) / 1000);
        if (hudTime) hudTime.textContent = `0:${String(Math.min(s, 59)).padStart(2, '0')}`;
      }, 250);
    }
    function settle(after: number) {
      later(after, () => {
        setHud('idle', IDLE);
        setPressed(null);
        if (hudTime) hudTime.textContent = '0:00';
      });
    }
    function listen(mode: Mode, html: string) {
      reset();
      listening = mode;
      setPressed(mode);
      if (detail) detail.innerHTML = DETAIL[mode];
      setHud('listening', html);
      startClock();
    }
    function deliver(html: string) {
      reset();
      listening = null;
      handsFree = false;
      setHud('polishing', '<b>Polishing</b> · five-source context + span gate');
      later(540, () => {
        setHud('delivered', html);
        settle(1900);
      });
    }

    function run(mode: Mode) {
      if (mode === 'toggle') {
        if (listening === 'toggle') return deliver('<b>Delivered</b> · "Open Waybar in Next.js..."');
        listen('toggle', '<b>Listening</b> · focused window T3 Code');
        later(2600, () => deliver('<b>Delivered</b> · "Open Waybar in Next.js..."'));
      } else if (mode === 'command') {
        listen('command', '<b>Voice command</b> · "make this tighter"');
        later(1700, () => deliver('<b>Rewritten</b> · selection updated in place'));
      } else if (mode === 'studio') {
        reset();
        listening = null;
        setPressed('studio');
        if (detail) detail.innerHTML = DETAIL.studio;
        setHud('delivered', '<b>Shuush Studio</b> · opened floating window');
        settle(2000);
      }
    }

    function holdStart() {
      holdStartedAt = performance.now();
      if (listening === 'ptt' && handsFree) {
        stopOnRelease = true;
        return;
      }
      listen('ptt', '<b>Push-to-talk</b> · holding F9');
    }
    function holdEnd() {
      if (listening !== 'ptt') return;
      if (stopOnRelease) {
        stopOnRelease = false;
        return deliver('<b>Delivered</b> · hands-free take');
      }
      if (performance.now() - holdStartedAt < 300) {
        handsFree = true;
        setHud('listening', '<b>Hands-free</b> · tap F9 again to stop');
        later(4600, () => deliver('<b>Delivered</b> · hands-free take'));
        return;
      }
      deliver('<b>Delivered</b> · push-to-talk take');
    }

    const keyEls = (id: string) => document.querySelectorAll<HTMLElement>(`.key[data-key="${id}"]`);
    const setKey = (id: string, down: boolean) => keyEls(id).forEach((k) => (k.dataset.down = String(down)));
    const comboKeys = (c: HTMLElement) => Array.from(c.querySelectorAll<HTMLElement>('.key'));
    const releaseAll = () => document.querySelectorAll<HTMLElement>('.key[data-down="true"]').forEach((k) => (k.dataset.down = 'false'));

    combos.forEach((combo) => {
      const mode = combo.dataset.mode as Mode;
      const keys = comboKeys(combo);
      const press = (down: boolean) => keys.forEach((k) => (k.dataset.down = String(down)));

      combo.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        combo.setPointerCapture(e.pointerId);
        press(true);
        if (mode === 'ptt') holdStart();
      });
      const up = () => {
        if (!keys.some((k) => k.dataset.down === 'true')) return;
        press(false);
        if (mode === 'ptt') holdEnd();
      };
      combo.addEventListener('pointerup', up);
      combo.addEventListener('pointercancel', up);

      combo.addEventListener('click', (e) => {
        const fromKeyboard = e.detail === 0;
        if (fromKeyboard) {
          keys.forEach((k, i) => {
            setTimeout(() => (k.dataset.down = 'true'), i * 55);
            setTimeout(() => (k.dataset.down = 'false'), i * 55 + 170);
          });
          if (mode === 'ptt') {
            holdStart();
            holdEnd();
            return;
          }
        }
        if (mode !== 'ptt') run(mode);
      });
    });

    const KEYMAP: Record<string, string> = { Meta: 'super', OS: 'super', Super: 'super', Control: 'ctrl', Alt: 'alt', F9: 'f9', d: 'd', D: 'd', e: 'e', E: 'e' };
    const isTyping = (t: EventTarget | null) =>
      t instanceof HTMLElement && (t.isContentEditable || t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT');

    document.addEventListener('keydown', (e) => {
      if (isTyping(e.target)) return;
      const id = KEYMAP[e.key];
      if (!id) return;
      setKey(id, true);
      if (e.repeat) return;
      if (id === 'f9') {
        e.preventDefault();
        holdStart();
      } else if (id === 'd' && e.metaKey && e.ctrlKey) run('toggle');
      else if (id === 'e' && e.metaKey && e.ctrlKey) run('command');
      else if (id === 'd' && e.metaKey && e.altKey) run('studio');
    });
    document.addEventListener('keyup', (e) => {
      const id = KEYMAP[e.key];
      if (!id) return;
      if (id === 'super') releaseAll();
      else setKey(id, false);
      if (id === 'f9') holdEnd();
    });
    window.addEventListener('blur', () => {
      releaseAll();
      if (listening === 'ptt' && !handsFree) holdEnd();
    });
  </script>
</BaseLayout>
