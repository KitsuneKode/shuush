# Maintainer: KitsuneKode <bhuyanmanash2002@gmail.com>
pkgname=shuush-git
pkgver=r1.0000000
pkgrel=1
pkgdesc="Local GPU dictation intelligence layer, 5-source screen context, anti-paraphrase cleanup & GTK4 Studio built on voxtype"
arch=('any')
url="https://shuush.kitsunekode.in"
license=('MIT')
depends=(
  'bash'
  'curl'
  'jq'
  'python'
  'python-gobject'
  'gtk4'
  'libadwaita'
  'at-spi2-core'
  'wl-clipboard'
)
makedepends=('git')
optdepends=(
  'voxtype-bin: stock local GPU speech-to-text daemon (required at runtime)'
  'wtype: Wayland virtual keyboard text injection'
  'quickshell: KitsuneHud 60fps liquid-glass Wayland waveform pill'
  'ollama: 100% air-gapped local LLM cleanup'
  'libnotify: desktop review notifications'
)
provides=('shuush')
conflicts=('shuush')
install=shuush-git.install
source=("$pkgname::git+https://github.com/KitsuneKode/shuush.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd "$srcdir/$pkgname"

  install -Dm755 bin/shuush "$pkgdir/usr/bin/shuush"
  cat > "$pkgdir/usr/bin/shuush-studio" <<'EOF'
#!/usr/bin/env bash
exec /usr/bin/shuush studio "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/shuush-studio"

  install -dm755 "$pkgdir/usr/lib/shuush/libexec"
  for f in libexec/*; do
    [ -f "$f" ] || continue
    base="$(basename "$f")"
    case "$base" in
      *.sh|voxtype-studio.py|voxtype_learn.py|voxtype-review.py|voxtype-llm-proxy.py|voxtype_screen_ctx.py|voxtype_pp_gate.py)
        install -m755 "$f" "$pkgdir/usr/lib/shuush/libexec/$base" ;;
      *)
        install -m644 "$f" "$pkgdir/usr/lib/shuush/libexec/$base" ;;
    esac
  done

  install -Dm644 osd/kitsune-hud/KitsuneHud.qml "$pkgdir/usr/share/shuush/osd/kitsune-hud/KitsuneHud.qml"
  install -Dm644 osd/kitsune-hud/voxtype-osd.toml "$pkgdir/usr/share/shuush/osd/kitsune-hud/voxtype-osd.toml"
  install -Dm644 config/postprocess.env.example "$pkgdir/usr/share/shuush/config/postprocess.env.example"
  install -Dm644 config/hyprland-binds.conf "$pkgdir/usr/share/shuush/config/hyprland-binds.conf"
  install -Dm644 config/kuwai.lua "$pkgdir/usr/share/shuush/config/kuwai.lua"

  sed "s|@BIN_DIR@|/usr/bin|g" config/shuush-studio.desktop > "$srcdir/shuush-studio.desktop"
  install -Dm644 "$srcdir/shuush-studio.desktop" "$pkgdir/usr/share/applications/shuush-studio.desktop"

  sed "s|@LIBEXEC@|/usr/lib/shuush/libexec|g" config/shuush-llm-proxy.service > "$srcdir/shuush-llm-proxy.service"
  sed "s|@LIBEXEC@|/usr/lib/shuush/libexec|g" config/shuush-live-osd.service > "$srcdir/shuush-live-osd.service"
  install -Dm644 "$srcdir/shuush-llm-proxy.service" "$pkgdir/usr/lib/systemd/user/shuush-llm-proxy.service"
  install -Dm644 "$srcdir/shuush-live-osd.service" "$pkgdir/usr/lib/systemd/user/shuush-live-osd.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
