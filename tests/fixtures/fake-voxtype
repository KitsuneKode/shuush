#!/usr/bin/env python3
"""A stand-in for the voxtype CLI, for tests that must never run the real one.

It answers `--version`, `config schema --json`, `config set/unset` and the
--help probes from a schema fixture (FAKE_SCHEMA, default: stock 1.3.1) and
edits the TOML under $XDG_CONFIG_HOME/voxtype/config.toml like voxtype does:
validated keys only, exit 2 for a key it does not know, comments kept.
A schema with the fork's keys (audio.queue_dictations) also gets the fork's
`record recover` and `record stop --no-post-process`. Everything else
(`record start`, ...) is only logged. FAKE_LOG names a file that
gets one line per call.
"""
import json
import os
import re
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
schema_path = os.environ.get("FAKE_SCHEMA") or str(HERE / "schema-stock.json")
SCHEMA = json.load(open(schema_path))
KEYS = {k["key"]: k for k in SCHEMA["keys"]}
FORK = "audio.queue_dictations" in KEYS   # the fork's CLI has `record recover` and `record stop --no-post-process`
CFG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "voxtype" / "config.toml"
args = sys.argv[1:]

if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write(" ".join(args) + "\n")


def flat(d, prefix=""):
    for k, v in d.items():
        if isinstance(v, dict):
            yield from flat(v, f"{prefix}{k}.")
        else:
            yield f"{prefix}{k}", v


def file_values():
    try:
        return dict(flat(tomllib.loads(CFG.read_text())))
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def split(key):
    section, _, name = key.rpartition(".")
    return section, name


def lit(value):
    return json.dumps(value) if isinstance(value, str) else ("true" if value is True else "false" if value is False else str(value))


def edit(key, literal):
    """Set (literal) or remove (None) one key, keeping the rest of the file."""
    section, name = split(key)
    text = CFG.read_text() if CFG.exists() else ""
    lines = text.splitlines(keepends=True)
    head = re.compile(r"^\s*\[([^\]]+)\]\s*(?:#.*)?$")
    start = end = None
    if section:
        for i, line in enumerate(lines):
            m = head.match(line)
            if m:
                if start is not None:
                    end = i
                    break
                if m.group(1).strip() == section:
                    start = i
        if start is not None and end is None:
            end = len(lines)
    else:
        first = next((i for i, line in enumerate(lines) if head.match(line)), len(lines))
        start, end = -1, first
    if start is None:
        if literal is None:
            return
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        if lines and lines[-1].strip():
            lines.append("\n")
        lines += [f"[{section}]\n", f"{name} = {literal}\n"]
    else:
        pat = re.compile(rf"^\s*{re.escape(name)}\s*=")
        hit = next((i for i in range(start + 1, end) if pat.match(lines[i])), None)
        if hit is not None:
            if literal is None:
                del lines[hit]
            else:
                lines[hit] = f"{name} = {literal}\n"
        elif literal is not None:
            at = end
            while at > start + 1 and not lines[at - 1].strip():
                at -= 1
            lines.insert(at, f"{name} = {literal}\n")
    CFG.parent.mkdir(parents=True, exist_ok=True)
    CFG.write_text("".join(lines))


def coerce(k, raw):
    t = k["type"]
    if t == "bool":
        if raw.lower() in ("true", "1", "yes", "on"):
            return True
        if raw.lower() in ("false", "0", "no", "off"):
            return False
        raise ValueError("not a boolean")
    if t == "int":
        v = int(raw)
        if ("min" in k and v < k["min"]) or ("max" in k and v > k["max"]):
            raise ValueError("out of range")
        return v
    if t == "enum" and "choices" in k and raw not in k["choices"]:
        raise ValueError("not one of the choices")
    if raw == "":
        raise ValueError("empty value")
    return raw


if args[:1] == ["--version"]:
    print(f"voxtype {SCHEMA['daemon_version']}")
elif args[:3] == ["config", "schema", "--json"]:
    fv = file_values()
    out = {"schema_version": 1, "daemon_version": SCHEMA["daemon_version"], "keys": []}
    for k in SCHEMA["keys"]:
        out["keys"].append({**k, "file_value": fv.get(k["key"])})
    print(json.dumps(out))
elif args[:2] in (["config", "set"], ["config", "unset"]) and "--help" in args:
    print("usage")
elif args[:3] == ["record", "stop", "--help"]:
    print("Stop recording and transcribe\n      --type\n      --paste")
    if FORK:
        print("      --no-post-process")
elif args[:3] == ["record", "recover", "--help"]:
    if FORK:
        print("usage")
    else:
        print("error: unrecognized subcommand 'recover'", file=sys.stderr)
        sys.exit(2)
elif args[:2] == ["config", "set"] and len(args) == 4:
    key, raw = args[2], args[3]
    if key not in KEYS or not KEYS[key].get("compiled", True):
        print(f"error: unknown key {key}", file=sys.stderr)
        sys.exit(2)
    try:
        edit(key, lit(coerce(KEYS[key], raw)))
    except ValueError as e:
        print(f"error: {key}: {e}", file=sys.stderr)
        sys.exit(2)
elif args[:2] == ["config", "unset"] and len(args) == 3:
    if args[2] not in KEYS:
        print(f"error: unknown key {args[2]}", file=sys.stderr)
        sys.exit(2)
    edit(args[2], None)
elif args[:1] == ["daemon"]:
    print("the fake voxtype never runs a daemon", file=sys.stderr)
    sys.exit(99)
