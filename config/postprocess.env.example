# Shuush post-process configuration (~/.config/voxtype/postprocess.env)
# Keys live separately in ~/.config/voxtype/secrets.env (chmod 600):
#   GROQ_API_KEY=...
#   OPENROUTER_API_KEY=...

# Failover chain: space-separated from {groq, groq2, cerebras, openrouter, opencode, local}.
# Recommended with free keys (docs/models.md): "groq groq2 cerebras openrouter".
# "local" alone keeps everything on this machine.
PP_ORDER="local groq"

# Local Ollama fallback (100% offline, zero cloud calls when placed first)
PP_LOCAL_URL="http://127.0.0.1:11434"
PP_LOCAL_MODEL="qwen3:4b-instruct-2507-q4_K_M"

# Cleanup latency budget & streaming threshold
PP_BUDGET_MS=6000
PP_STREAM_MIN_WORDS=60

# 5-source context & privacy controls (1 = on, 0 = off)
PP_APP_CONTEXT=1
PP_SCREEN_CONTEXT=1
PP_CLIPBOARD_CONTEXT=1
PP_PRIVATE_GUARD=1
PP_AUTO_LEARN=1

# Clipboard & hold-to-talk behavior
# PP_KEEP_ON_CLIPBOARD=1 also puts each dictation on the clipboard (never lost);
# set 0 to leave the clipboard alone (what you copied stays).
PP_KEEP_ON_CLIPBOARD=1
# Release tail (ms) before stopping push-to-talk so final syllables aren't clipped
PP_RELEASE_TAIL_MS=200
# Queue overlapping takes in hold mode while the previous take is still transcribing.
# Only on a daemon that has [audio] queue_dictations (shuush caps has queue_dictations); there it
# is auto-detected when the daemon publishes queue_pid. Set 0 to disable.
# VOXTYPE_QUEUE=0
# Learn from names you fix by hand in the field right after a dictation
# (needs PP_SCREEN_CONTEXT=1; first sighting goes to Studio's Learning Inbox)
PP_WATCH_EDITS=1
# Back-to-back dictations into the same field get a leading space, and continue
# an unfinished sentence in lowercase (needs PP_SCREEN_CONTEXT=1)
PP_SMART_JOIN=1
# To press Enter after a dictation, end it with the word "submit" and set
# smart_auto_submit = true under [text] in config.toml (voxtype built-in).

# Delivery ownership (default: daemon — voxtype delivers; set shuush to let
# Shuush's ordered delivery queue own typing, long-text pasting, and streaming).
# After switching to shuush, run `shuush wire` and enable `shuush-deliver.service`.
PP_DELIVERY=daemon
# Paste takes longer than this many characters in PP_DELIVERY=shuush (0 = always type).
# Private takes are never pasted and never touch the clipboard.
PP_PASTE_OVER_CHARS=300
# Stream-type verified sentences as they arrive in PP_DELIVERY=shuush (1 = on, 0 = off).
PP_STREAM_TYPING=1
# Paste shortcut in PP_DELIVERY=shuush: auto (ctrl+shift+v in terminals, ctrl+v elsewhere),
# shift+insert, ctrl+v, ctrl+shift+v, or super+v.
# PP_PASTE_KEYS=auto
# Empty-string-safe replacements handled by Shuush in PP_DELIVERY=shuush:
# PP_AUTO_SUBMIT=0
# PP_SMART_AUTO_SUBMIT=0
# PP_APPEND_TEXT=""

# Optional speaker bio / accent hint for the cleanup LLM
# PP_SPEAKER_BIO="Software engineer dictating coding prompts and technical notes."
