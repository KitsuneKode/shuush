[Unit]
Description=Shuush live OSD session watcher & idle inhibitor for voxtype
PartOf=voxtype.service
After=voxtype.service
Conflicts=voxtype-live-osd.service

[Service]
Type=simple
ExecStart=@LIBEXEC@/voxtype-live-osd.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=voxtype.service graphical-session.target
